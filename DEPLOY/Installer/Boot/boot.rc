// boot.rc — ресурсы обёртки установщика: иконка установщика и манифест (asInvoker).
#include <winres.h>
1 ICON "../Branding/AStory.ico"
1 RT_MANIFEST "boot.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "AStory Remake"
      VALUE "FileDescription", "AStory Remake Setup"
      VALUE "ProductName", "AStory Remake"
      VALUE "LegalCopyright", "AStory Remake"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
