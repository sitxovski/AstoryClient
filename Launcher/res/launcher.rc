#pragma code_page(65001)
// launcher.rc — ресурсы AsdaLauncher.exe: иконка игры, фон и логотип окна, манифест, сведения о версии.
// bg.jpg — кадр RawAssets/Textures/map/load/Start_logo.png (размыт, затемнён); logo.png — логотип из JUI/n_03.png.
#include <winres.h>

1   ICON    "app.ico"
101 RCDATA  "bg.jpg"
102 RCDATA  "logo.png"
1   24      "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "AStory Remake"
            VALUE "FileDescription", "AStory Remake Launcher"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "AsdaLauncher"
            VALUE "OriginalFilename", "AsdaLauncher.exe"
            VALUE "ProductName", "AStory Remake"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
